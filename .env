# 应用基础配置
APP_NAME = Nest Ts Server            # 应用名称
APP_PORT = 18000                     # 应用端口
APP_BASE_URL = http://localhost:${APP_PORT}  # 应用基础URL
APP_LOCALE = zh-CN                   # 应用语言环境
PROJECT_DIR = /nest-ts-server        # 项目目录

# 登录相关配置
MULTI_DEVICE_LOGIN = true           # 是否允许多设备同时登录

# 日志配置
LOGGER_LEVEL = verbose              # 日志级别：verbose-详细
LOGGER_MAX_FILES = 31               # 日志文件最大保存天数

TZ = Asia/Shanghai                  # 时区设置

# 对象存储配置(七牛云)
OSS_ACCESSKEY=xxx                   # 七牛云访问密钥
OSS_SECRETKEY=xxx                   # 七牛云私有密钥
OSS_DOMAIN=https://cdn.buqiyuan.site # CDN域名
OSS_BUCKET=nest-ts-server           # 存储空间名称
OSS_ZONE=Zone_z2                    # 存储区域: Zone_as0-亚太 | Zone_na0-北美 | Zone_z0-华东 | Zone_z1-华北 | Zone_z2-华南
OSS_ACCESS_TYPE=public              # 访问类型：public-公开 | private-私有