# 日志配置
LOGGER_LEVEL = debug                # 调试级别日志

# 安全认证配置
JWT_SECRET = admin!@#123            # JWT加密密钥
JWT_EXPIRE = 86400                  # JWT过期时间（单位：秒）
REFRESH_TOKEN_SECRET = admin!@#123  # 刷新令牌密钥
REFRESH_TOKEN_EXPIRE = 2592000      # 刷新令牌过期时间（30天）

# Swagger文档配置
SWAGGER_ENABLE = true               # 是否启用Swagger
SWAGGER_PATH = api-docs             # Swagger文档路径
SWAGGER_VERSION = 1.0               # API版本号

# 数据库配置
DB_HOST = host.docker.internal      # Docker环境数据库主机
DB_PORT = 3306                      # 数据库端口
DB_DATABASE = nest_admin            # 数据库名称
DB_USERNAME = root                  # 数据库用户名
DB_PASSWORD = root                  # 数据库密码
DB_SYNCHRONIZE = false              # 禁用自动同步数据库结构
DB_LOGGING = ["error"]              # 数据库日志记录级别

# Redis配置
REDIS_PORT = 6379                   # Redis端口
REDIS_HOST = host.docker.internal   # Docker环境Redis主机
REDIS_PASSWORD = 123456             # Redis密码
REDIS_DB = 0                        # Redis数据库索引

# 邮件服务配置
SMTP_HOST = smtp.163.com            # SMTP服务器地址
SMTP_PORT = 465                     # SMTP服务器端口
SMTP_USER = nest_admin@163.com      # SMTP用户名
SMTP_PASS = VIPLLOIPMETTROYU        # SMTP授权码

# 系统配置
IS_DEMO = false                     # 是否为演示模式